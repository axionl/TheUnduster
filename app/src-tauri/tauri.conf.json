{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheUnduster",
  "version": "0.2.0",
  "identifier": "com.theunduster.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Photography",
    "copyright": "Ariel AxionL (i@axionl.me) | github id: @axionl",
    "shortDescription": "Find and remove dust and scratches from scanned film",
    "longDescription": "TheUnduster finds and removes dust and scratches from scanned film. Defect detection runs a neural network through ONNX Runtime, using CoreML on Apple Silicon with a CPU fallback. Healing uses LaMa inpainting.",
    "resources": {
      "../../engine/fixtures/demo-detector.onnx": "fixtures/demo-detector.onnx",
      "../../engine/fixtures/tiny-detector.onnx": "fixtures/tiny-detector.onnx",
      "resources/luts/kodak-endura.cube": "luts/kodak-endura.cube",
      "resources/luts/kodak-ektacolor.cube": "luts/kodak-ektacolor.cube",
      "resources/luts/ilford-mgfb2.cube": "luts/ilford-mgfb2.cube"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "TheUnduster | ikFilm+",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' tiles: data:; connect-src 'self' tiles: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  }
}
